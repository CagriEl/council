APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Filament panel yöneticisi (php artisan db:seed veya AdminUserSeeder)
# FILAMENT_ADMIN_EMAIL=admin@kirklareli.local
# FILAMENT_ADMIN_PASSWORD=password
# FILAMENT_ADMIN_NAME="Panel Yöneticisi"
# Üretimde migrate:fresh / db:wipe yasak; istisna için: ALLOW_DESTRUCTIVE_DB_COMMANDS=true
# İsteğe bağlı: resmî duyuru listesi URL’si (boşsa https://kirklareli.bel.tr/resmi-duyurular/2). DB’ye yazmak için: php artisan sync:resmi-announcements
# ANNOUNCEMENTS_SCRAPER_URL=https://kirklareli.bel.tr/resmi-duyurular/2
# Cloudflare Turnstile
# TURNSTILE_ENABLED=true
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# E-Odeme servis ayarları (BELSIS)
# E_ODEME_WSDL doluysa kullanılır; boşsa E_ODEME_TAHAKKUK_WSDL (tahakkuk) yedek olarak okunur.
# WSDL yoksa E_ODEME_LOCATION + E_ODEME_URI birlikte zorunludur.
# Tahsilat WSDL yalnızca referans; borç listesi tahakkuk üzerinden.
# Uzak WSDL çoğu ortamda HTML döner; VPN ile alınan dosyayı storage/app/belsis/ koyun:
# E_ODEME_WSDL_LOCAL=belsis/tahakkuk.wsdl
# İndirme denemesi (yalnızca gerçek XML dönerse yazar): php artisan belsis:fetch-wsdl "https://...tahakkukWebServis.asmx?wsdl" --insecure
# E_ODEME_WSDL=
# E_ODEME_TAHAKKUK_WSDL=https://aykome.belsis.uygulama.belsis.com.tr/tahakkukWebServis.asmx?wsdl
# E_ODEME_TAHSILAT_WSDL=https://aykome.belsis.uygulama.belsis.com.tr/tahsilatWebServis.asmx?wsdl
# BELSIS dokümanına göre SOAP borcSorgula gövdesinde genelde bankaKodu / bankaSifresi / kurumKodu (parolayı repoya yazmayın):
# E_ODEME_BANKA_KODU=
# E_ODEME_BANKA_SIFRESI=
# E_ODEME_KURUM_KODU=
# E_ODEME_LOCATION=
# E_ODEME_URI=
# E_ODEME_BORC_SORGULA_METHOD=borcSorgula
# Süresi dolmuş sertifika vb. için yalnızca test: E_ODEME_SOAP_VERIFY_SSL=false
# E_ODEME_SOAP_VERIFY_SSL=true
# E_ODEME_TIMEOUT=20
# Varsayılanlar artık 60 IP / 30 numara (10 dk); local ortamda ek üst sınır uygulanır.
# E_ODEME_RATE_LIMIT_IP_ATTEMPTS=60
# E_ODEME_RATE_LIMIT_ID_ATTEMPTS=30
# E_ODEME_RATE_LIMIT_DECAY_MINUTES=10
# Borç sorgusu denetim kayıtları için hedef saklama (gün; yasal metinde gösterilir)
# E_ODEME_AUDIT_RETENTION_DAYS=365

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
